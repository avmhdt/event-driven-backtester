# .env.example  (copy to .env and fill in; never commit .env)

# --- Binance USD-M futures TESTNET (required from M5; testnet keys ONLY, never mainnet) ---
BINANCE_TESTNET_API_KEY=            # required for mode=testnet; HMAC key from the testnet site
BINANCE_TESTNET_API_SECRET=         # required for mode=testnet; never logged, never printed
BINANCE_TESTNET_REST_URL=           # optional override; default in configs/live_testnet.toml; must be on the allowlist
BINANCE_TESTNET_WS_MARKET_URL=      # optional override; must be on the allowlist
BINANCE_TESTNET_WS_API_URL=         # optional override; must be on the allowlist

# --- Tardis.dev (optional, paid; leave empty to use free first-of-month downloads) ---
TARDIS_API_KEY=                     # optional; only used if D-04 approved spend

# --- Paths ---
DATA_ROOT=~/data/event-driven-backtester  # required; data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loaders)
EDBT_DATA_DIR=                      # optional; root for raw/, interim/, processed/ and canonical datasets; empty = DATA_ROOT
EDBT_EXTERNAL_DATA_ROOTS=           # optional; ':'-separated read-only roots (e.g. ~/data/crypto-lob-alpha, the shared crypto capture)
EDBT_RESULTS_DIR=./results          # required; run outputs and experiment_log.csv

# --- Logging ---
RUST_LOG=info                       # optional; tracing filter, e.g. edbt_live=debug
EDBT_LOG_FORMAT=text                # optional; text | json (json for long-running live sessions)
